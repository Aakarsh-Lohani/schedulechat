# --- Required ---
# Which AI provider powers the copilot: "anthropic" (default) or "gemini".
AI_PROVIDER=anthropic

# Set the key for whichever provider you chose above (only one is required).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MongoDB connection string (local: mongodb://localhost:27017/schedulechat, or an Atlas URI)
MONGODB_URI=mongodb://localhost:27017/schedulechat

# Optional Read-Only MongoDB URI for AI Copilot "Suggest" mode access control.
# If omitted, Suggest mode will strictly inform the user that read-only DB setup is not complete.
# MONGODB_READONLY_URI=mongodb://readonly_user:password@localhost:27017/schedulechat

# Google Calendar OAuth credentials (optional, for connecting Google Calendar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=secret-for-next-auth-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Single-user login (seeded by `npm run seed`)
APP_USER_EMAIL=chat@schedule.ai
APP_USER_PASSWORD=password
